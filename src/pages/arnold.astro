---
import "../style.scss";
import Lift from "../components/Lift.astro";
import Tracker from "../components/Tracker.astro";
import { workouts, week, sessionSets } from "../data/arnold";

const navDays = [...week.map((d) => d.key), "sun"];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#121212">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>Arnold's routine</title>
</head>
<body>
    <main class="page" id="top" data-store="arnold-progress-v1" data-open="today">
        <a class="back-link" href="/">my workout plan</a>
        <h1 class="page-title">Arnold Schwarzenegger's routine</h1>
        <p class="page-intro">His prime double split: workout A and workout B alternate Monday to Saturday, each with a morning and an afternoon session. Sunday is off. Today opens on its own.</p>

        <nav class="day-nav week" aria-label="days">
            {navDays.map((k) => <a href={`#day-${k}`} data-nav={k}>{k}</a>)}
        </nav>

        <details class="day guide">
            <summary>
                <h2 class="day-main">
                    <span class="day-title">how to run this routine</span>
                </h2>
                <span class="chev" aria-hidden="true"></span>
            </summary>
            <ul class="guide-list">
                <li><strong>Supersets:</strong> do both exercises back to back with no rest, then rest 60 sec. Finish every round of one superset before starting the next, and rest 2 to 3 min between supersets.</li>
                <li><strong>Pyramids:</strong> add weight as the reps drop. The highlighted number is the target for the round you are on.</li>
                <li><strong>Tempo:</strong> about 2 sec lowering and 1 to 2 sec lifting.</li>
                <li><strong>Effort:</strong> take the last sets of each exercise close to failure, and add weight as you get stronger.</li>
                <li><strong>Spacing:</strong> leave 4 to 6 hours between the morning and afternoon sessions.</li>
                <li><strong>Tracking:</strong> tap a set or round when it is done. The rest timer starts on its own and buzzes when rest is over.</li>
            </ul>
            <p class="guide-note">About 89 working sets a day and 534 a week, for 14 to 20 hours of training a week. This is a competition bodybuilding load and is more than most natural lifters can recover from. The routine is reconstructed from Arnold's published training, so rest times and session lengths are estimates.</p>
        </details>

        {week.map((d) => {
            const w = workouts[d.workout];
            const total = w.sessions.reduce((n, s) => n + sessionSets(s), 0);
            return (
                <details class="day" id={`day-${d.key}`} data-day={d.key}>
                    <summary>
                        <h2 class="day-main">
                            <span class="day-num">{d.name} · workout {w.key}</span>
                            <span class="day-title">{w.sessions.map((s) => s.title).join(" · ")}</span>
                        </h2>
                        <span class="day-progress" data-progress>0/{total}</span>
                        <span class="chev" aria-hidden="true"></span>
                    </summary>
                    <div class="day-body">
                        {w.sessions.map((s, si) => (
                            <section class="session">
                                <h3 class="session-label">{s.when}: {s.title}</h3>
                                <p class="session-meta">{s.time} · {sessionSets(s)} working sets</p>
                                {s.sections.map((sec, xi) => (
                                    <>
                                        {sec.label && <h4 class="section-label">{sec.label}</h4>}
                                        <div class="lifts">
                                            {sec.blocks.map((b, bi) => (
                                                <Lift id={`${d.key}-${si}-${xi}-${bi}`} block={b} />
                                            ))}
                                        </div>
                                    </>
                                ))}
                            </section>
                        ))}
                        <button type="button" class="reset" data-reset>reset {d.name}</button>
                    </div>
                </details>
            );
        })}

        <details class="day" id="day-sun" data-day="sun">
            <summary>
                <h2 class="day-main">
                    <span class="day-num">sunday</span>
                    <span class="day-title">rest day</span>
                </h2>
                <span class="chev" aria-hidden="true"></span>
            </summary>
            <p class="rest-day-text">No weight training. Eat well and get plenty of sleep so you recover for Monday.</p>
        </details>
    </main>

    <Tracker />
</body>
</html>
