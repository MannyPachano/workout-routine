---
import "../style.scss";
import Day from "../components/Day.astro";
import Session from "../components/Session.astro";
import Tracker from "../components/Tracker.astro";
import ChestWorkout from "../components/ChestWorkout.astro";
import SecondSession from "../components/SecondSession.astro";
import { back, quads, arms, shoulders, glutes, mobility } from "../data/routine";

const dayNumbers = [1, 2, 3, 4, 5, 6, 7];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#121212">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>manny workout plan</title>
</head>
<body>
    <main class="page" id="top" data-store="workout-progress-v5" data-open="remember" data-open-key="workout-open-day-v1">
        <h1 class="page-title">workout plan</h1>
        <a class="page-link" href="/arnold">Arnold Schwarzenegger's routine</a>

        <nav class="day-nav" aria-label="days">
            <span class="day-nav-label">day</span>
            {dayNumbers.map((n) => <a href={`#day-${n}`} data-nav={n}>{n}</a>)}
        </nav>

        <details class="day guide">
            <summary>
                <h2 class="day-main">
                    <span class="day-title">how to use this page</span>
                </h2>
                <span class="chev" aria-hidden="true"></span>
            </summary>
            <ul class="guide-list">
                <li><strong>Sets:</strong> tap a set when it is done. The next set is outlined, and the counter on each day shows sets done out of the total.</li>
                <li><strong>Supersets:</strong> do both exercises back to back with no rest, then tap the round. A round counts as two sets.</li>
                <li><strong>Rest timer:</strong> starts on its own after each tap and buzzes when rest is over. Sets of 8 reps or fewer get 2 min, up to 12 reps get 90 sec, higher reps and supersets get 60 sec, and timed holds get 45 sec.</li>
            </ul>
        </details>

        <details class="day mobility">
            <summary>
                <h2 class="day-main">
                    <span class="day-title">mobility exercises</span>
                </h2>
                <span class="chev" aria-hidden="true"></span>
            </summary>
            <ul class="mobility-list">
                {mobility.map((name) => <li>{name}</li>)}
            </ul>
        </details>

        <Day n={1} title="morning chest · evening abs">
            <ChestWorkout id="d1-am" variant="mid" label="morning: chest" />
            <SecondSession id="d1-pm" day="d1" label="evening: abs + forearms" />
        </Day>

        <Day n={2} title="back & biceps · obliques">
            <Session id="d2-back" label="back & biceps" items={back} />
            <SecondSession id="d2-obl" day="d2" label="obliques + traps" />
        </Day>

        <Day n={3} title="quads · abs">
            <Session id="d3-pm" label="quads" items={quads} />
            <SecondSession id="d3-abs" day="d3" label="abs + hips" />
        </Day>

        <Day n={4} title="chest · obliques">
            <ChestWorkout id="d4-chest" variant="incline" label="chest" />
            <SecondSession id="d4-obl" day="d4" label="obliques + forearms" />
        </Day>

        <Day n={5} title="morning lower chest · evening arms + abs">
            <ChestWorkout id="d5-am" variant="lower" label="morning: lower chest" />
            <Session id="d5-pm" label="evening: arms" items={arms} />
            <SecondSession id="d5-abs" day="d5" label="evening: abs + rear delts" />
        </Day>

        <Day n={6} title="shoulders · obliques">
            <Session id="d6-shoulders" label="shoulders" items={shoulders} />
            <SecondSession id="d6-obl" day="d6" label="obliques + traps" />
        </Day>

        <Day n={7} title="glutes & hamstrings · abs">
            <Session id="d7-glutes" label="glutes & hamstrings" items={glutes} />
            <SecondSession id="d7-abs" day="d7" label="abs + hips" />
        </Day>
    </main>

    <Tracker />
</body>
</html>
